{
  "manifest_version": 3,
  "name": "Recipe to FairPrice Cart",
  "version": "0.1.0",
  "description": "Collect recipes from AllRecipes and build a FairPrice shopping list.",
  "permissions": ["activeTab", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://floatskivers.onrender.com/*",
    "https://www.allrecipes.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
